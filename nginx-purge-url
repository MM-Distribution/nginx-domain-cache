#!/usr/bin/python3.12 -I
# nginx-purge-url: delete cPanel's nginx page-cache copies of single pages, so the next request goes to the site.
#
#   nginx-purge-url [-n] [--prefix] <url> [<url> ...]
#     -n, --dry-run  list what would be deleted, delete nothing
#     --prefix       every cached page whose path starts with the URL's path (e.g. https://example.com/blog/)
#   Options apply to every URL on the command line; run --prefix purges on their own.
#
# By default a URL matches that exact path with or without a query string (?page=2, ?nocache=...), for
# http and https, and for the host with and without "www.". Copies are found by the "KEY: <url>" line nginx
# writes into each cache file under /var/cache/ea-nginx/proxy/<account>/; only files under that folder are
# deleted. Use nginx-domain-cache for a whole domain. Matching: nginx_purge.py (shared with nginx-purge-spool).
import os
import sys

for d in (os.path.dirname(os.path.realpath(__file__)), "/usr/local/lib/nginx-purge"):
    sys.path.insert(0, d) if d not in sys.path else None
import nginx_purge  # noqa: E402

NAME = "nginx-purge-url"


def main(argv):
    if os.geteuid() != 0:
        sys.exit(f"{NAME}: run as root")
    dry = prefix = False
    urls = []
    for a in argv:
        if a in ("-n", "--dry-run"):
            dry = True
        elif a == "--prefix":
            prefix = True
        elif a in ("-h", "--help"):
            print(__doc__ or open(__file__).read().split("\n#\n")[0]); return 0
        elif a.startswith("-"):
            sys.exit(f"{NAME}: unknown option: {a} (see --help)")
        else:
            urls.append(a)
    if not urls:
        sys.exit(f"usage: {NAME} [-n] [--prefix] <url> [<url> ...]")
    try:
        targets = [nginx_purge.parse(u, prefix) for u in urls]
    except nginx_purge.BadUrl as e:
        sys.exit(f"{NAME}: {e}")
    r = nginx_purge.purge(targets, dry_run=dry)
    for u in r.unknown:
        print(f"{NAME}: {nginx_purge.parse(u).bare_host}: not a domain on this server ({nginx_purge.DOMAINS_FILE}), skipped",
              file=sys.stderr)
    for key in r.deleted:
        print(f"{'would delete' if dry else 'deleted'}: {key}")
    for u in r.not_cached:
        print(f"{u}: not cached")
    n = len(r.deleted)
    word = "copy" if n == 1 else "copies"
    print(f"{n} cached {word} would be deleted (dry run)" if dry else f"{n} cached {word} deleted")
    return 1 if r.unknown else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
