# One per account in /etc/nginx-purge/accounts (nginx-purge-spool --setup enables them): start
# nginx-purge-spool.service when the account's site drops a finished list of changed pages (*.urls). The kernel
# tells systemd when a file appears: nothing polls. (A single glob over all folders doesn't work: systemd only
# watches the folder above the first wildcard.)
[Unit]
Description=Watch /var/spool/nginx-purge/%i for pages to purge from the nginx cache

[Path]
PathExistsGlob=/var/spool/nginx-purge/%i/*.urls
Unit=nginx-purge-spool.service

[Install]
WantedBy=multi-user.target
